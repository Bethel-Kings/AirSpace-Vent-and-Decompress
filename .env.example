# Environment Configuration for AirSpace MVP
ENVIRONMENT=development
PORT=8000
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Local development default (SQLite): sqlite:///./airspace.db
# Render production default (PostgreSQL): postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./airspace.db

# AI Provider Configuration (Decompress & Reframe)
AI_PROVIDER=gemini
AI_PROVIDER_API_KEY=your_gemini_or_provider_api_key_here
AI_MODEL_NAME=gemini-2.5-flash

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
